# TeddyPups U.A.E. Backend Environment Configuration

# Database: MySQL connection string (or leave commented/empty for SQLite dev fallback)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/teddypups_db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Settings
ENVIRONMENT=development
APP_NAME=TeddyPups U.A.E. API
HOST=0.0.0.0
PORT=8000
